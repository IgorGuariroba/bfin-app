{
  "name": "bfin-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "docker compose up -d && npx wait-on tcp:5432 && node scripts/db-migrate.mjs && npm run seed",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "npx tsx scripts/seed.mts",
    "smoke": "node scripts/smoke.mjs",
    "stop": "pkill -f 'next dev' || true; docker compose down",
    "knip": "knip",
    "jscpd": "jscpd",
    "prepare": "husky"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "^2.5.0",
    "@grafana/faro-web-tracing": "^2.5.0",
    "@next/env": "^16.2.12",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@uiw/react-md-editor": "^4.1.0",
    "@vercel/otel": "^2.1.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-opentelemetry-transport": "^3.0.0",
    "radix-ui": "^1.6.4",
    "react": "19.2.8",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "reading-time": "^1.5.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@grafana/faro-webpack-plugin": "^0.12.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^26",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "husky": "^9.1.7",
    "jscpd": "^5.0.12",
    "knip": "^6.27.0",
    "lint-staged": "^17.2.0",
    "pino-pretty": "^13.1.3",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts}": [
      "eslint --fix",
      "vitest related --project unit --run"
    ]
  }
}
