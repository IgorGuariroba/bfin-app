{
  "name": "bfin-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "docker compose up -d && npx wait-on tcp:5432 && npx prisma migrate deploy && npm run seed",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "npx tsx prisma/seed.mts",
    "stop": "pkill -f 'next dev' || true; docker compose down"
  },
