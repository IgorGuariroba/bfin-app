generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  plan             String    @default("free")
  planExpiresAt    DateTime?
  mpSubscriptionId String?
  accounts         Account[]
  sessions       Session[]
  transactions   Transaction[]
  previsoes      Previsao[]
  tags           Tag[]
  ownedMembers   AccountMember[] @relation("OwnedMembers")
  memberOf       AccountMember[] @relation("MemberOf")
}

model AccountMember {
  id          String   @id @default(cuid())
  ownerId     String
  memberId    String?
  inviteEmail String
  inviteToken String   @unique
  role        String   @default("editor")
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  owner       User     @relation("OwnedMembers", fields: [ownerId], references: [id], onDelete: Cascade)
  member      User?    @relation("MemberOf", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([memberId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String
  description String
  amount      Float
  date        DateTime
  repeat      String   @default("none")
  repeatEnd   String   @default("forever")
  repeatCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags        Tag[]

  @@index([userId, date])
  @@index([userId, type])
}

model Tag {
  id           String        @id @default(cuid())
  userId       String
  name         String
  color        String
  isSystem     Boolean       @default(false)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
}

model Previsao {
  id     String @id @default(cuid())
  userId String
  name   String
  amount Float
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlanConfig {
  id            String   @id @default("default")
  monthlyAmount Float    @default(14.9)
  annualAmount  Float    @default(119.9)
  updatedAt     DateTime @updatedAt
}

model WhatsappContact {
  id           String                @id @default(cuid())
  phone        String                @unique
  name         String?
  createdAt    DateTime              @default(now())
  conversation WhatsappConversation?
}

model WhatsappConversation {
  id            String            @id @default(cuid())
  contactId     String            @unique
  status        String            @default("bot")
  lastMessageAt DateTime          @default(now())
  createdAt     DateTime          @default(now())
  contact       WhatsappContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages      WhatsappMessage[]

  @@index([status, lastMessageAt])
}

model WhatsappMessage {
  id             String               @id @default(cuid())
  conversationId String
  direction      String
  sender         String
  body           String
  wamid          String?              @unique
  createdAt      DateTime             @default(now())
  conversation   WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
