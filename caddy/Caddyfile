# Headers de segurança (issue #116). CSP completa fica fora de escopo —
# exigiria inventário dos scripts/estilos inline do Next; aqui só o
# frame-ancestors contra clickjacking.
(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Content-Security-Policy "frame-ancestors 'none'"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

www.bfincont.com.br {
    import security_headers
    redir https://bfincont.com.br{uri} permanent
}

bfincont.com.br {
    import security_headers
    encode zstd gzip
    reverse_proxy app:3000
}
